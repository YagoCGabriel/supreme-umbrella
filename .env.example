PORT=3000
CACHE_TTL_SECONDS=300

# Remote collection is disabled by default. Set both flags to true only when
# you have explicit authorization applicable to automated access.
CIFRACLUB_FETCH_ENABLED=false
CIFRACLUB_FETCH_AUTHORIZED=false

# Provider routing: httpx (direct), scrapfly (explicit), or auto.
# auto uses HTTPX first and falls back to Scrapfly only on network errors/5xx.
# It never falls back after upstream 401/403/429/451 responses.
SCRAPER_PROVIDER=auto
SCRAPFLY_API_KEY=
SCRAPFLY_RENDER_JS=false
SCRAPFLY_TIMEOUT_SECONDS=45

SCRAPER_TIMEOUT_SECONDS=15
SCRAPER_MAX_RETRIES=2
SCRAPER_MIN_INTERVAL=1.5
SCRAPER_BROWSER_FALLBACK=false
# Optional Selenium Grid URL, for authorized browser-based fallback only.
SELENIUM_REMOTE_URL=http://selenium:4444
