
{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "app": {
      "root": ".",
      "framework": "flask"
    },
    "app-two": {
      "root": "app",
      "framework": "flask"
    },
    "cli": {
      "root": "cli",
      "runtime": "python"
    }
  },
  "rewrites": [
    {
      "source": "/dashboard/(.*)",
      "destination": {
        "service": "app-two"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "app"
      }
    }
  ]
}
